{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "useUnknownInCatchVariables": false,
    "strict": false,
    "strictNullChecks": false,

    "incremental": true
  },
  "buildOptions": {
    "incremental": true
  },
  "typeAcquisition": {
    "enable": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
